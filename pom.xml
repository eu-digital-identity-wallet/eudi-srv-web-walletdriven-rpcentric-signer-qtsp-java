<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>eu.europa.ec.eudi.signer.r3</groupId>
    <artifactId>qtsp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>qtsp</name>

    <modules>
        <module>authorization_server</module>
        <module>resource_server</module>
        <module>common_tools</module>
    </modules>

    <properties>
        <java.version>17</java.version>

        <mysql.version>9.0.0</mysql.version>
        <nimbus-jose-jwt.override.version>10.9</nimbus-jose-jwt.override.version>
        <httpclient.version>4.5.13</httpclient.version>
        <bouncycastle.version>1.85</bouncycastle.version>
        <dss.version>6.0</dss.version>
        <jacknji11.version>1.2-pk3</jacknji11.version>
        <org-json.version>20231013</org-json.version>
        <springdoc.version>2.9.1</springdoc.version>
        <commons-text.version>1.12.0</commons-text.version>
        <zxing.version>3.5.3</zxing.version>
        <waltid-mdoc.version>0.12.0</waltid-mdoc.version>
        <kotlinx-datetime.version>0.6.2</kotlinx-datetime.version>
        <cose-java.version>1.1.0</cose-java.version>
        <jackson.version>3.1.6</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--Internal modules-->
            <dependency>
                <groupId>eu.europa.ec.eudi.signer.r3</groupId>
                <artifactId>common_tools</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--Database-->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!--JSON-->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${org-json.version}</version>
            </dependency>

            <!--Http Client-->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>

            <!--Crypto-->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!--DSS-->
            <dependency>
                <groupId>eu.europa.ec.joinup.sd-dss</groupId>
                <artifactId>dss-enumerations</artifactId>
                <version>${dss.version}</version>
            </dependency>

            <!--HSM JacknJi11-->
            <dependency>
                <groupId>org.signserver.jacknji11</groupId>
                <artifactId>jacknji11</artifactId>
                <version>${jacknji11.version}</version>
            </dependency>

            <!--COSE; VPToken-->
            <dependency>
                <groupId>id.walt.mdoc-credentials</groupId>
                <artifactId>waltid-mdoc-credentials-jvm</artifactId>
                <version>${waltid-mdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-datetime-jvm</artifactId>
                <version>${kotlinx-datetime.version}</version>
            </dependency>
            <dependency>
                <groupId>com.augustcellars.cose</groupId>
                <artifactId>cose-java</artifactId>
                <version>${cose-java.version}</version>
            </dependency>

            <!--Swagger-->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!--Utils-->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>

            <!--QrCode Render-->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
